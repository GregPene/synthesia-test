{
  "name": "synthesia-interactive-avatar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Synthesia interactive avatar: a LiveKit voice agent lip-synced by a Synthesia avatar, plus a browser client.",
  "scripts": {
    "agent": "tsx src/agent.ts dev",
    "agent:start": "tsx src/agent.ts start",
    "download-files": "tsx src/agent.ts download-files",
    "web": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@livekit/agents": "^1.10.0",
    "@livekit/agents-plugin-silero": "^1.10.0",
    "@livekit/agents-plugin-synthesia": "^1.10.0",
    "@livekit/rtc-node": "^1.2.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "livekit-client": "^2.24.0",
    "livekit-server-sdk": "^2.19.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
