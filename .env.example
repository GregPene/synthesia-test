# Synthesia workspace API key (Synthesia > Settings > API)
SYNTHESIA_API_KEY=

# Optional: Synthesia gallery avatar ID(s), comma-separated, max 5
# SYNTHESIA_AVATAR_ID=03cee7ec-ac90-45ec-8c20-74a399cf3dc4

# LiveKit Cloud project (cloud.livekit.io > Settings > API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Port for the web client
PORT=3000
