# Synthesia workspace API key (Synthesia > Settings > API)
SYNTHESIA_API_KEY=


# Synthesia avatar ID(s) your workspace can access, comma-separated, max 5
SYNTHESIA_AVATAR_ID=

# LiveKit Cloud project (cloud.livekit.io > Settings > API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Port for the web client
PORT=3000
